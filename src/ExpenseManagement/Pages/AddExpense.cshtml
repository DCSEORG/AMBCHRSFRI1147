@page
@model ExpenseManagement.Pages.AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

<div class="add-expense-page">
    <h1>Add Expense</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post" class="expense-form">
        <div class="form-group">
            <label for="Amount">Amount (£):</label>
            <input type="number" id="Amount" name="Amount" step="0.01" min="0.01" max="999" 
                   value="@Model.Amount" required class="form-control" />
            <small class="form-help">Maximum £999 (£99 for travel expenses)</small>
        </div>

        <div class="form-group">
            <label for="ExpenseDate">Date:</label>
            <input type="date" id="ExpenseDate" name="ExpenseDate" 
                   value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" required class="form-control" />
        </div>

        <div class="form-group">
            <label for="CategoryId">Category:</label>
            <select id="CategoryId" name="CategoryId" required class="form-control">
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="Description">Description:</label>
            <textarea id="Description" name="Description" rows="4" class="form-control" 
                      placeholder="Enter expense description...">@Model.Description</textarea>
            <small class="form-help">Tip: Include 'train' to automatically categorize as Travel</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Submit</button>
            <a href="/Expenses" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
