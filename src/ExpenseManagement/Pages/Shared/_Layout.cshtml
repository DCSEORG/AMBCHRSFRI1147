<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Expense Management</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="navbar-brand">
                <a href="/">Expense Management System</a>
            </div>
            <div class="navbar-menu">
                <a href="/Index" class="nav-link">Dashboard</a>
                <a href="/Expenses" class="nav-link">Expenses</a>
                <a href="/AddExpense" class="nav-link">Add Expense</a>
                <a href="/Approve" class="nav-link">Approve</a>
                <a href="/Chat" class="nav-link">Chat</a>
                <a href="/swagger" class="nav-link" target="_blank">API Docs</a>
            </div>
        </nav>
    </header>

    @if (ViewData["ErrorInfo"] is ExpenseManagement.Models.ErrorInfo errorInfo)
    {
        <div class="error-banner">
            <div class="error-content">
                <strong>⚠️ @errorInfo.Message</strong>
                @if (!string.IsNullOrEmpty(errorInfo.File))
                {
                    <span class="error-location">at @errorInfo.File:@errorInfo.Line</span>
                }
                @if (!string.IsNullOrEmpty(errorInfo.Guidance))
                {
                    <p class="error-guidance">@errorInfo.Guidance</p>
                }
            </div>
        </div>
    }

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; @DateTime.Now.Year Expense Management System</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
