@page
@model ExpenseManagement.Pages.ExpensesModel
@{
    ViewData["Title"] = "Expenses";
}

<div class="expenses-page">
    <h1>Expenses</h1>

    <form method="get" class="filter-form">
        <div class="filter-row">
            <div class="filter-group">
                <label for="searchTerm">Filter:</label>
                <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Search description..." />
            </div>
            <div class="filter-group">
                <label for="categoryId">Category:</label>
                <select id="categoryId" name="categoryId">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="statusId">Status:</label>
                <select id="statusId" name="statusId">
                    <option value="">All Statuses</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status.StatusId" selected="@(Model.StatusId == status.StatusId)">@status.StatusName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/Expenses" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model.Expenses)
            {
                <tr>
                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                    <td>@expense.CategoryName</td>
                    <td>£@expense.AmountDisplay.ToString("N2")</td>
                    <td><span class="status-badge status-@expense.StatusName.ToLower()">@expense.StatusName</span></td>
                    <td>@expense.Description</td>
                    <td class="actions">
                        @if (expense.StatusName == "Draft")
                        {
                            <a href="/EditExpense/@expense.ExpenseId" class="btn btn-small">Edit</a>
                            <form method="post" asp-page-handler="Submit" asp-route-id="@expense.ExpenseId" style="display:inline;">
                                <button type="submit" class="btn btn-small btn-primary">Submit</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@expense.ExpenseId" style="display:inline;">
                                <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Delete this expense?')">Delete</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Expenses.Any())
            {
                <tr>
                    <td colspan="6" class="empty-message">No expenses found</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="page-actions">
        <a href="/AddExpense" class="btn btn-primary">Add New Expense</a>
    </div>
</div>
