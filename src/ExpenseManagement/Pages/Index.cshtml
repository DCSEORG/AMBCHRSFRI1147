@page
@model ExpenseManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">
    <h1>Expense Dashboard</h1>
    
    <div class="summary-cards">
        <div class="card">
            <h3>Total Expenses</h3>
            <p class="amount">£@Model.TotalAmount.ToString("N2")</p>
            <p class="count">@Model.TotalCount expenses</p>
        </div>
        
        @foreach (var summary in Model.StatusSummary)
        {
            <div class="card status-@summary.StatusName.ToLower()">
                <h3>@summary.StatusName</h3>
                <p class="amount">£@summary.TotalAmountDisplay.ToString("N2")</p>
                <p class="count">@summary.ExpenseCount expenses</p>
            </div>
        }
    </div>

    <div class="actions">
        <a href="/AddExpense" class="btn btn-primary">Add New Expense</a>
        <a href="/Expenses" class="btn btn-secondary">View All Expenses</a>
        <a href="/Approve" class="btn btn-secondary">Approve Expenses</a>
    </div>

    <div class="category-breakdown">
        <h2>Expenses by Category</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Count</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.CategorySummary)
                {
                    <tr>
                        <td>@cat.CategoryName</td>
                        <td>@cat.ExpenseCount</td>
                        <td>£@cat.TotalAmountDisplay.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="recent-expenses">
        <h2>Recent Expenses</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in Model.RecentExpenses)
                {
                    <tr>
                        <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                        <td>@expense.CategoryName</td>
                        <td>£@expense.AmountDisplay.ToString("N2")</td>
                        <td><span class="status-badge status-@expense.StatusName.ToLower()">@expense.StatusName</span></td>
                        <td>@expense.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
