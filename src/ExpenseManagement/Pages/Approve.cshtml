@page
@model ExpenseManagement.Pages.ApproveModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="approve-page">
    <h1>Approve Expenses</h1>
    <p class="subtitle">Pending expenses:</p>

    <form method="get" class="filter-form">
        <div class="filter-row">
            <div class="filter-group">
                <label for="searchTerm">Filter:</label>
                <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" 
                       placeholder="Search..." class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/Approve" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Amount</th>
                <th>User</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model.PendingExpenses)
            {
                <tr>
                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                    <td>@expense.CategoryName</td>
                    <td>£@expense.AmountDisplay.ToString("N2")</td>
                    <td>@expense.UserName</td>
                    <td>@expense.Description</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="Approve" asp-route-id="@expense.ExpenseId" style="display:inline;">
                            <button type="submit" class="btn btn-small btn-success">Approve</button>
                        </form>
                        <form method="post" asp-page-handler="Reject" asp-route-id="@expense.ExpenseId" style="display:inline;">
                            <button type="submit" class="btn btn-small btn-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.PendingExpenses.Any())
            {
                <tr>
                    <td colspan="6" class="empty-message">No pending expenses to approve</td>
                </tr>
            }
        </tbody>
    </table>
</div>
